[Unit]
Description=Auralis: auto-select the EasyEffects preset for the current output device
# Start only once the desktop session and the audio stack are up; started any
# earlier, the watcher has no display environment and nothing to talk to.
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service filter-chain.service
Wants=filter-chain.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/auralis watch
# The watcher exits whenever the audio server goes away; keep bringing it back.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
